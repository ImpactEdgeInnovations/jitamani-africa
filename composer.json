{
  "name": "impactedgeinnovations/jitamani-africa",
  "description": "Jitamani Africa — a bespoke editorial website and essential Kirby content editor.",
  "type": "project",
  "require": {
    "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
    "getkirby/cms": "^5.2"
  },
  "config": {
    "allow-plugins": {"getkirby/composer-installer": true},
    "optimize-autoloader": true
  },
  "scripts": {
    "start": ["Composer\\Config::disableProcessTimeout", "@php -S localhost:8000 router.php"],
    "test": "@php tests/run.php"
  }
}
